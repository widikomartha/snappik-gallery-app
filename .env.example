# Generate local values using npm run setup:local. Never use local mode publicly.
APP_MODE=local
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://snappik:GENERATED_BY_SETUP@127.0.0.1:55432/snappik
BETTER_AUTH_SECRET=GENERATED_BY_SETUP
LOCAL_MAIL_KEY=GENERATED_BY_SETUP
# Optional local logical backups: a separate 64-hex key, held outside backup storage.
LOCAL_BACKUP_KEY=
# disabled | synthetic | google_public (local approved root only).
INVENTORY_ADAPTER=disabled
# Configure privately, explicitly approve caching, then run npm run drive:configure-local.
GOOGLE_DRIVE_APPROVED_ROOT_ID=
GOOGLE_DRIVE_LOCAL_CACHE_APPROVED=false
GOOGLE_DRIVE_API_KEY_ENCRYPTED=

# Production authentication (set privately through the deployment secret store).
# APP_MODE=production
# APP_URL=https://your-approved-host.example
# DATABASE_URL=postgresql://.../snappik?sslmode=verify-full
# BETTER_AUTH_SECRET=<32-64 random bytes encoded as hexadecimal; same across replicas>
# AUTH_OWNER_EMAILS=<comma-separated invited owner/operator addresses; maximum 100>
# SMTP_HOST=<approved provider hostname>
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=<private SMTP login>
# SMTP_PASSWORD=<private SMTP credential>
# SMTP_FROM=<verified sender email address>
# SMTP_TLS=implicit is also supported (normally port 465). TLS verification is mandatory.
# LOCAL_MAIL_KEY is only required by local mail/approved local Drive encryption.
# Production never writes local_mail; mail:local refuses production mode.
# Keep INVENTORY_ADAPTER=disabled in production until D-02/D-03 authorize hosting.
