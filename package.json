{
  "name": "snappik-gallery-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/db-local.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "mail:local": "tsx --env-file=.env.local scripts/mail-local.ts",
    "worker": "tsx --env-file=.env.local src/worker/main.ts",
    "drive:configure-local": "tsx scripts/configure-drive-local.ts",
    "drive:verify-live": "tsx --env-file=.env.local scripts/verify-drive-live.ts",
    "test": "tsx --test tests/validation.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/integration.test.ts tests/projects.test.ts",
    "test:browser": "tsx scripts/test-browser.ts",
    "test:projects:browser": "tsx scripts/test-projects-browser.ts",
    "test:inventory": "tsx --test --test-concurrency=1 tests/inventory.test.ts tests/public-drive.test.ts tests/drive-config.test.ts",
    "test:inventory:browser": "tsx scripts/test-inventory-browser.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.11",
    "@better-auth/kysely-adapter": "1.7.11",
    "better-auth": "1.7.11",
    "kysely": "0.29.7",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "otpauth": "9.5.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
